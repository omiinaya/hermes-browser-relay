{
  "manifest_version": 3,
  "name": "CDP Bridge",
  "version": "1.0.0",
  "description": "Bridges Chrome DevTools Protocol to Hermes Agent via WebSocket — navigate, inspect, scrape with full network visibility",
  "permissions": [
    "debugger",
    "activeTab",
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
