# browser-relay Configuration
# Copy to .env and adjust for your setup.
# All values shown are the defaults.

# CDP relay server address
# CDP_SERVER=http://127.0.0.1:9223

# Tool call timeout in seconds
# RELAY_TIMEOUT=60

# Path to server.py (for auto-start)
# RELAY_SERVER_PATH=server.py

# Relay server host/port (when starting server.py)
# RELAY_HOST=0.0.0.0
# RELAY_PORT=9223
