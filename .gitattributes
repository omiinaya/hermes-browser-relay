# Auto-detect text files
* text=auto

# Python
*.py text diff=python

# JavaScript
*.js text
*.mjs text
*.cjs text

# Markdown
*.md text diff=markdown

# YAML/JSON
*.yml text
*.yaml text
*.json text

# Shell
*.sh text eol=lf

# Makefile
Makefile text eol=lf

# Images (binary)
*.png binary
*.ico binary

# Archives
*.min.js binary linguist-generated=true
